# ============================================================
# 该留该走 · 服务端环境变量示例
# ------------------------------------------------------------
# 复制成 .env（本地）或在 Vercel 项目设置里逐条填（线上）。
# ⚠️ 这里只写变量名和说明，永远不要把真实 Key 提交进仓库。
# ============================================================

# ---------- 必填 ----------

# 模型服务商给你的 API Key。
# 不要写在这里，也不要在任何前端文件里出现。
API_KEY=your_api_key_here

# 视觉模型名（负责认品类、看成色，必须支持图片输入）
VISION_MODEL=your_vision_model_name

# ---------- 建议填写 ----------

# 文本模型名（负责写理由和发布文案）。留空则复用 VISION_MODEL。
TEXT_MODEL=your_text_model_name

# OpenAI 兼容接口的 base URL，不要带 /chat/completions。
# 换服务商只改这一行 + 上面的 KEY 和模型名。
#   DeepSeek     https://api.deepseek.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动     https://api.siliconflow.cn/v1
#   火山方舟     https://ark.cn-beijing.volces.com/api/v3
#   智谱         https://open.bigmodel.cn/api/paas/v4
API_BASE_URL=https://api.deepseek.com/v1

# ---------- 超时与限额（一般不用改） ----------

# 视觉模型超时，毫秒。规格文档要求 12s。
VISION_TIMEOUT_MS=12000

# 文本模型超时，毫秒。规格文档要求 8s。
TEXT_TIMEOUT_MS=8000

# 单次请求总预算，兜住 Vercel 的 maxDuration。
TOTAL_BUDGET_MS=22000

# 单张图片上限 / 下限，字节。8MB 对齐 E3 的错误文案。
MAX_IMAGE_BYTES=8388608
MIN_IMAGE_BYTES=2048

# ---------- 跨域与模型行为 ----------

# 允许跨域的来源。生产环境建议收紧成你的 H5 域名，
# 例如 https://gailiu.example.com
ALLOW_ORIGIN=*

# 是否要求模型返回 JSON 对象（1=要求）。OpenAI 兼容接口都支持。
JSON_MODE=1

# 采样温度。0.2 = 稳定优先，这个产品不需要发散。
TEMPERATURE=0.2

# 置信度 low 时是否一律判为"没认出来"（1=是）。
# 默认开，因为规格明确要求"绝不给一个猜的答案"。
LOW_CONFIDENCE_AS_UNKNOWN=1

# 文本模型失败时是否降级返回（1=降级）。
# 0（默认）：返回 502，让前端走 E2 重试页 —— 用户能拿到完整结果。
# 1：返回 200，结论和价格仍然可信（来自规则表），只有文案为空。
DEGRADE_ON_WRITER_FAILURE=0

# ---------- 仅本地测试用，线上绝对不要开 ----------

# 1 = 使用 lib/mock.js 的假模型，不发起任何网络请求。
# production 环境下这个开关默认被拒绝（除非另外设 ALLOW_MOCK_IN_PROD=1）。
MOCK_MODE=0

# 假模型的行为：normal | unknown | not-in-table | low-confidence | kettle
#   | schema-fail-once | schema-fail-always | not-json | category-name
#   | writer-schema-fail-once | writer-schema-fail-always | writer-error
#   | timeout | upstream-error | degrade
MOCK_SCENARIO=normal
